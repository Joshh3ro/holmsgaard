@page "/home"

<PageTitle>Oversigt - Holmsgaard</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Holmsgaard</h1>
            <p class="text-muted mb-0">Intern oversigt for medarbejdere, aktiviteter og tidsregistrering.</p>
        </div>
        <div class="d-flex gap-2 align-items-start">
            <a class="btn btn-primary" href="time">
                <span class="bi bi-clock-fill me-2" aria-hidden="true"></span>
                Registrer tid
            </a>
            <a class="btn btn-outline-primary" href="employees">
                <span class="bi bi-people-fill me-2" aria-hidden="true"></span>
                Medarbejdere
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <section class="border rounded p-3 h-100">
                <h2 class="h5">Backend</h2>
                <p class="text-muted mb-3">API'et er bygget med Controllers, DTO'er, Commands, Queries, Services og repository-interfaces.</p>
                <span class="badge text-bg-success">Klar til CRUD-demo</span>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="border rounded p-3 h-100">
                <h2 class="h5">Frontend</h2>
                <p class="text-muted mb-3">Blazor-siderne bruger backend-data til medarbejdere og tidsregistrering.</p>
                <span class="badge text-bg-primary">Login-flow startet</span>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="border rounded p-3 h-100">
                <h2 class="h5">Næste fokus</h2>
                <p class="text-muted mb-3">Rigtig JWT-beskyttelse, OWASP-gennemgang, concurrency og Docker/Compose vil give høj eksamensværdi.</p>
                <span class="badge text-bg-warning">Planlagt</span>
            </section>
        </div>
    </div>
</div>
